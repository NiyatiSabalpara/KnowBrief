# Copy this file to backend/.env. Never store real credentials in Git.
PROJECT_NAME="KnowBrief"
VERSION="1.0.0"
API_V1_STR="/api"

# SQLite path is relative to backend/ when the API is started with python run.py.
DATABASE_URL="sqlite:///knowledge_base.db"

# Local frontend origins allowed by the API.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Timeout for fetching public article pages.
REQUEST_TIMEOUT_SECONDS=12
